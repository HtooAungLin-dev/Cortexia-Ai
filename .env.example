# ========================================================
# Cortexia AI - Environment Configuration Example
# ========================================================

# --------------------------------------------------------
# Backend Environment Variables (Render / Railway / VPS / Cloud Run)
# --------------------------------------------------------
# Your Google Gemini API Key (Required for live Gemini models)
GEMINI_API_KEY=

# Server port (default: 3000)
PORT=3000

# Set MODE=api-only when deploying backend standalone without building frontend
MODE=api-only

# Node environment (development or production)
NODE_ENV=production


# --------------------------------------------------------
# Frontend Environment Variables (Vercel / Netlify / Cloudflare Pages)
# --------------------------------------------------------
# Base URL pointing to your separately hosted backend server.
# Leave blank or omit if running full-stack on the same domain/proxy.
# Example: https://cortexia-api.onrender.com
VITE_API_BASE_URL=
